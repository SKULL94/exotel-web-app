# VoIP POC Server Configuration

# Server settings
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ai-coustics Sparrow SDK settings
# License key from https://developer.ai-coustics.com
AIC_SDK_LICENSE=eyJ1c2VyIjoidXNlcl8zOWJUTlhlTEtSTG1ubUR4eHRXMmdUM0h2b1giLCJ2ZXJzaW9uIjoiMiIsImFwaV9rZXkiOiJmM2Y3Yzg3YjI2OTcwNWI5MDQ3OTI1ZDAxMWI3OWQyZjc4MjRlOGRiYTVkNzJjOWU1NGI1MTFlZGZkNTAzYzM0In0=.

# Model to use — sparrow-s-8khz matches Exotel's 8kHz telephony audio
# Model is auto-downloaded on first run; no manual download needed
AIC_MODEL_ID=sparrow-s-8khz

# Directory where the model is cached after download
AIC_MODEL_PATH=./models/sparrow

# Set to false to disable noise cancellation (bypass mode)
AIC_ENABLE_NC=true

# Audio settings (match Exotel output)
AUDIO_SAMPLE_RATE=8000

# Set to true to save raw + processed WAV files for debugging
SAVE_AUDIO_FILES=true
